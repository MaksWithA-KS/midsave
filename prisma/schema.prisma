generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImportStatus {
  NEVER
  OK
  PRIVATE_PROFILE
  FAILED
}

enum MatchStatus {
  MATCHED
  NO_IGDB_MATCH
  FILTERED_NON_GAME
}

enum Platform {
  STEAM
}

enum Bucket {
  FINISH_TONIGHT
  GOOD_PROGRESS
  NO_COMMITMENT
}

enum TimeBracket {
  HALF_HOUR
  HOUR_OR_TWO
  LONG_EVENING
  NOT_SURE
}

model User {
  id             Int          @id @default(autoincrement())
  steamId        String       @unique
  displayName    String?
  avatarUrl      String?
  importStatus   ImportStatus @default(NEVER)
  lastImportedAt DateTime?
  createdAt      DateTime     @default(now())

  games       UserGame[]
  snapshots   PlaytimeSnapshot[]
  suggestions SuggestionLog[]
}

model IgdbGame {
  id                Int      @id
  name              String
  hastilySeconds    Int?
  normallySeconds   Int?
  completelySeconds Int?
  sampleCount       Int?
  updatedAt         DateTime @updatedAt
  gameModes         Int[]    @default([])

  games Game[]
}

model Game {
  id          Int         @id @default(autoincrement())
  steamAppId  Int?        @unique
  name        String
  matchStatus MatchStatus
  igdbGameId  Int?
  igdbGame    IgdbGame?   @relation(fields: [igdbGameId], references: [id])

  owners      UserGame[]
  snapshots   PlaytimeSnapshot[]
  suggestions SuggestionLog[]

  @@index([igdbGameId])
}

model UserGame {
  userId                Int
  gameId                Int
  platform              Platform  @default(STEAM)
  playtimeMinutes       Int
  playtime2WeeksMinutes Int       @default(0)
  lastPlayedAt          DateTime?
  userMarkedFinished    Boolean?
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@id([userId, gameId, platform])
}

model PlaytimeSnapshot {
  id              Int      @id @default(autoincrement())
  userId          Int
  gameId          Int
  playtimeMinutes Int
  takenAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@index([userId, gameId, takenAt])
}

model SuggestionLog {
  id          Int         @id @default(autoincrement())
  userId      Int
  gameId      Int
  bucket      Bucket
  timeBracket TimeBracket
  shownAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@index([userId, timeBracket, shownAt])
}
